#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define CLMK     0
#define QWERTY   1
#define NAV      2
#define MAC_NAV  3
#define NUMBER   4
#define SYMBOL   5
#define FN       6
#define GAMING   7
#define ADJUST   8
#define MOUSE    9
#define SNIPE    10
#define CODE     11
#define MAC      12

#define ___ &trans
#define XXX &none

&caps_word {
    continue-list = <MINUS UNDERSCORE BACKSPACE DELETE N0 N1 N2 N3 N4 N5 N6 N7 N8 N9>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    // Tap, then re-press within 200ms: the second press is treated as a tap
    // even when held. Lets you hold the BSPC/SPACE thumb to repeat after a
    // first tap, instead of triggering the layer.
    quick-tap-ms = <200>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <175>;
};

&sk {
    release-after-ms = <900>;
    quick-release;
};

/ {
    behaviors {
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 53>;
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50>;
        };

        magic_shift: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&sk>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        // Hold both thumb layer-taps NAV (left) and SYMBOL (right) to reach
        // ADJUST. Replaces the old &mo ADJUST on the right thumb so that
        // position can host MOUSE for trackball use.
        nav_symbol_adjust {
            if-layers = <NAV SYMBOL>;
            then-layer = <ADJUST>;
        };
        // While MAC mode is toggled on, holding NAV brings up the Mac-flavored
        // overlay that swaps Ctrl-prefixed clipboard/word ops to Cmd/Opt.
        mac_nav_overlay {
            if-layers = <NAV MAC>;
            then-layer = <MAC_NAV>;
        };
    };

    chosen { zmk,physical-layout = &gggw_crosses_54_layout; };

    keymap {
        compatible = "zmk,keymap";

        clmk_layer {
            display-name = "Clmk";
            bindings = <
                &kp GRAVE      &kp N1        &kp N2        &kp N3        &kp N4          &kp N5        &kp N6       &kp N7          &kp N8        &kp N9       &kp N0         &kp EQUAL
                ___            &kp Q         &kp W         &kp F         &kp P           &kp B         &kp J        &kp L           &kp U         &kp Y        &kp SEMI       ___
                &kp ESC        &hml LGUI A   &hml LALT R   &hml LCTRL S  &hml LSHFT T    &kp G         &kp M        &hmr RSHFT N    &hmr RCTRL E  &hmr RALT I  &hmr RGUI O    &kp SQT
                &caps_word     &kp Z         &kp X         &kp C         &kp D           &kp V         &kp K        &kp H           &kp COMMA     &kp DOT      &kp FSLH       &kp DEL
                                                            &magic_shift LSHFT LSHFT     &lt NAV SPACE &lt FN TAB   &lt SYMBOL RET  &lt NUMBER BSPC &mo MOUSE
            >;
        };

        qwerty_layer {
            display-name = "Qwerty";
            bindings = <
                &kp GRAVE      &kp N1        &kp N2        &kp N3        &kp N4          &kp N5        &kp N6       &kp N7          &kp N8        &kp N9       &kp N0         &kp EQUAL
                ___            &kp Q         &kp W         &kp E         &kp R           &kp T         &kp Y        &kp U           &kp I         &kp O        &kp P          ___
                &kp ESC        &hml LGUI A   &hml LALT S   &hml LCTRL D  &hml LSHFT F    &kp G         &kp H        &hmr RSHFT J    &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI &kp SQT
                &caps_word     &kp Z         &kp X         &kp C         &kp V           &kp B         &kp N        &kp M           &kp COMMA     &kp DOT      &kp FSLH       &kp DEL
                                                            &magic_shift LSHFT LSHFT     &lt NAV SPACE &lt FN TAB   &lt SYMBOL RET  &lt NUMBER BSPC &mo MOUSE
            >;
        };

        nav_layer {
            display-name = "Nav";
            // Row 1 left = clipboard ops with explicit Ctrl modifiers (the
            // K_UNDO/K_CUT system keycodes are inert on Win and Mac).
            // Arrows on row 3 (home row) so they sit under your right hand.
            // Row 2 right is the wider nav cluster (Home/PgDn/PgUp/End).
            bindings = <
                ___            ___           ___           ___           ___             ___           &kp LA(LEFT) &kp LA(RIGHT)   &kp LC(T)     &kp LC(W)    &kp LC(LS(T))  &kp INS
                &kp LA(TAB)    &sk LGUI      &sk LALT      &sk LCTRL     &sk LSHFT       ___           &kp F5       &kp HOME        &kp PG_DN     &kp PG_UP    &kp END        &kp K_CMENU
                ___            &kp LC(LEFT)  &kp LC(RIGHT) &kp LC(BSPC)  &kp LC(DEL)     ___           ___          &kp LEFT        &kp DOWN      &kp UP       &kp RIGHT      &kp DEL
                ___            &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)       &kp LC(Y)     &kp LC(A)    &kp LC(S)       &kp LC(H)     &kp LC(FSLH) &kp LS(TAB)    ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        mac_nav_layer {
            display-name = "MacNav";
            // Conditional overlay; only fires when MAC + NAV are both active.
            // Overrides only the keys whose modifier differs on macOS.
            // Cmd+Shift+Z is Mac redo. Word motion uses Opt instead of Ctrl.
            bindings = <
                ___            ___           ___           ___           ___             ___           &kp LG(LBKT) &kp LG(RBKT)    &kp LG(T)     &kp LG(W)    &kp LG(LS(T))  ___
                &kp LG(TAB)    ___           ___           ___           ___             ___           &kp LG(R)    ___             ___           ___          ___            ___
                ___            &kp LA(LEFT)  &kp LA(RIGHT) &kp LA(BSPC)  &kp LA(DEL)     ___           ___          ___             ___           ___          ___            ___
                ___            &kp LG(Z)     &kp LG(X)     &kp LG(C)     &kp LG(V)       &kp LG(LS(Z)) &kp LG(A)    &kp LG(S)       &kp LG(H)     &kp LG(FSLH) ___            ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
                ___            &kp LBKT      &kp N7        &kp N8        &kp N9          &kp RBKT      ___          &kp EQUAL      &kp DOT      &kp COMMA   &kp PRCNT      ___
                ___            &kp SEMI      &kp N4        &kp N5        &kp N6          &kp EQUAL     ___          &kp PLUS       &kp MINUS    &kp ASTRK   &kp FSLH       ___
                ___            &kp GRAVE     &kp N1        &kp N2        &kp N3          &kp BSLH      ___          ___            ___          ___         ___            ___
                ___            ___           ___           &kp DOT       &kp N0          &kp MINUS     ___          ___            ___          ___         ___            ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        symbol_layer {
            display-name = "Symbol";
            bindings = <
                ___            &kp LBRC      &kp AMPS      &kp ASTRK     &kp LPAR        &kp RBRC      ___          ___            ___          ___         ___            ___
                ___            &kp COLON     &kp DLLR      &kp PRCNT     &kp CARET       &kp PLUS      ___          &kp RSHFT      &kp RCTRL    &kp RALT    &kp RGUI       ___
                ___            &kp TILDE     &kp EXCL      &kp AT        &kp HASH        &kp PIPE      ___          ___            ___          ___         ___            ___
                ___            ___           ___           &kp LPAR      &kp RPAR        &kp UNDER     ___          ___            ___          ___         ___            ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        fn_layer {
            display-name = "Fn";
            // Cleaned out: just F-keys, system, and media. IDE and terminal
            // shortcuts moved to the Code layer.
            bindings = <
                &kp PSCRN      &kp F1        &kp F2        &kp F3        &kp F4          &kp F5        &kp F6       &kp F7         &kp F8       &kp F9      &kp F10        &kp F11
                &kp SLCK       &kp F12       ___           ___           ___             ___           ___          ___            ___          ___         ___            ___
                &kp PAUSE_BREAK ___          ___           ___           ___             ___           ___          ___            ___          ___         ___            ___
                ___            &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV      &kp C_NEXT    &kp C_PLAY_PAUSE &kp C_BRI_DN &kp C_BRI_UP ___        ___            ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        gaming_layer {
            display-name = "Gaming";
            bindings = <
                &kp GRAVE      &kp N1        &kp N2        &kp N3        &kp N4          &kp N5        &kp N6       &kp N7         &kp N8       &kp N9      &kp N0         &kp ESC
                &kp TAB        &kp Q         &kp W         &kp E         &kp R           &kp T         &kp Y        &kp U          &kp I        &kp O       &kp P          &kp BSPC
                &kp LSHFT      &kp A         &kp S         &kp D         &kp F           &kp G         &kp H        &kp J          &kp K        &kp L       &kp SEMI       &kp SQT
                &kp LCTRL      &kp Z         &kp X         &kp C         &kp V           &kp B         &kp N        &kp M          &kp COMMA    &kp DOT     &kp FSLH       &tog GAMING
                                                            &kp LALT                  &kp SPACE     &kp TAB      &kp RET        &kp BSPC      &mo MOUSE
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            // Reached by chording NAV (left thumb) + SYMBOL (right thumb).
            // Row 2 OS shortcuts are Windows-flavored; swap MAC on (row 1
            // col 11) for the Mac overlay (currently only adjusts Nav).
            bindings = <
                &bootloader    &kp PSCRN     &kp SLCK      &kp PAUSE_BREAK &kp INS       &kp DEL       &studio_unlock &kp K_CMENU   &kp CAPSLOCK &kp SYS_SLEEP &bootloader   &tog MAC
                ___            &kp LG(E)     &kp LG(R)     &kp LG(D)       &kp LG(LS(S)) &kp LC(LS(ESC)) &kp LG(SPACE) &kp LG(TAB)   &kp LG(GRAVE) &kp LG(LS(N4)) &kp LG(LA(ESC)) ___
                &bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_USB  &out OUT_BLE  &to CLMK      &to QWERTY    &tog GAMING   ___
                ___            ___           ___           ___             ___           &to CODE      &tog MOUSE    ___           ___           ___          ___           ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            // Held momentarily via &mo MOUSE on the right outer thumb, or
            // auto-activated by trackball motion (zip_temp_layer in the right
            // overlay, 500ms timeout, 300ms typing guard). Click cluster on
            // the left half so you can click while pointing with the right.
            // Hold &mo SNIPE (left bottom) for precision.
            bindings = <
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                ___            &mkp MB4      &mkp RCLK     &mkp MCLK     &mkp LCLK      &mkp MB5      ___          ___            ___          ___         ___            ___
                &mo SNIPE      ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        snipe_layer {
            display-name = "Snipe";
            // Activates the snipe override in the right overlay, dropping the
            // central trackball back to raw 600 cpi. Clicks fall through.
            bindings = <
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        code_layer {
            display-name = "Code";
            // Reached via &to CODE on the Adjust layer. Right outer thumb
            // exits back to Clmk. IDE shortcuts on row 2; terminal shortcuts
            // on row 3.
            bindings = <
                ___            &kp F1        &kp F2        &kp F3        &kp F4          &kp F5        &kp F6       &kp F7         &kp F8       &kp F9      &kp F10        &kp F12
                ___            &kp LC(P)     &kp LC(LS(P)) &kp LC(GRAVE) &kp LC(FSLH)    &kp LC(B)     ___          &kp LS(F12)    &kp LC(DOT)  &kp LC(COMMA) ___          ___
                ___            &kp LC(C)     &kp LC(D)     &kp LC(L)     &kp LC(R)       &kp LC(A)     &kp LC(E)    &kp LA(B)      &kp LA(F)    &kp LC(BSPC) &kp LC(DEL)   ___
                ___            &kp LC(W)     &kp LC(N)     &kp LC(T)     &kp LC(F)       &kp LC(LS(T)) ___          ___            ___          ___          ___           &to CLMK
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };

        mac_layer {
            display-name = "Mac";
            // Toggle flag layer. Mostly transparent; presence triggers the
            // MAC_NAV conditional overlay. Add per-position Mac overrides
            // here later if needed (Adjust OS shortcuts, etc.).
            bindings = <
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                ___            ___           ___           ___           ___            ___           ___          ___            ___          ___         ___            ___
                                                            ___                       ___           ___          ___             ___           ___
            >;
        };
    };
};
